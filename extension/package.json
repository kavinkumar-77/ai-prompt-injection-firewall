{
  "name": "prompt-firewall-extension",
  "version": "0.1.0",
  "description": "Chrome MV3 Extension for AI Prompt-Injection & Data-Leak Firewall",
  "scripts": {
    "build": "tsc --noEmit && esbuild src/content/content.ts --bundle --outfile=dist/content/content.js && esbuild src/popup/popup.ts --bundle --outfile=dist/popup/popup.js",
    "test": "vitest run"
  },
  "devDependencies": {
    "@types/chrome": "^0.0.268",
    "@types/jsdom": "^21.1.7",
    "esbuild": "^0.28.2",
    "jsdom": "^24.0.0",
    "typescript": "^5.4.0",
    "vitest": "^1.6.0"
  }
}
